{

    // Use IntelliSense to learn about possible attributes.

    // Hover to view descriptions of existing attributes.

    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387

    "version": "0.2.0",

    "configurations": [

      {
        "name": "Debug",
        "type": "dotnet",
        "request": "launch",
        "preLaunchTask": "dotnet: build",  // Optional
        "projectPath": "${workspaceFolder}/Sudoku/Sudoku.csproj"
      },       
      {
        "name": "Import",
        "type": "coreclr",
        "request": "launch",
        "preLaunchTask": "dotnet: build",  // Optional
        "program": "${workspaceFolder}/SudokuPuzzleImporter/bin/Debug/net10.0/SudokuPuzzleImporter.dll",
        "args": ["/mnt/Files/GIT/Sudoku/sudoku-3m.csv", "/mnt/Files/GIT/Sudoku"],
        "cwd": "${workspaceFolder}/SudokuPuzzleImporter",
        "console": "integratedTerminal"
      }

    ]

  }